DATABASE_URL=sqlite:///./train_tracker.db
TOMTOM_API_KEY=
TOMTOM_FLOW_ENDPOINT=v4
# Orbis alternative: https://api.tomtom.com/maps/orbis/traffic/tile/flow/{z}/{x}/{y}.pbf
TOMTOM_FLOW_URL_TEMPLATE=
TOMTOM_MONTHLY_REQUEST_BUDGET=190000
TOMTOM_SOFT_REQUEST_BUDGET=175000
FRA_REFRESH_DAYS=7
ENABLE_POLLER=1
AUTO_CREATE_SCHEMA=1
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TZ=America/Detroit

