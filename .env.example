TOMTOM_API_KEY=
TOMTOM_FLOW_ENDPOINT=v4
# Orbis alternative: https://api.tomtom.com/maps/orbis/traffic/tile/flow/{z}/{x}/{y}.pbf
TOMTOM_FLOW_URL_TEMPLATE=
TOMTOM_MONTHLY_REQUEST_BUDGET=190000
TOMTOM_SOFT_REQUEST_BUDGET=175000
FRA_REFRESH_DAYS=7
ENABLE_POLLER=1
# Cloud Run mode: disable the forever-loop and invoke POST /internal/poll
# from Cloud Scheduler once per minute.
SERVERLESS_POLLING=0
POLL_TRIGGER_TOKEN=
# Preferred Cloud Scheduler authentication. The scheduler service account
# sends an OIDC bearer token; the app verifies its audience and email.
POLL_TRIGGER_AUDIENCE=
POLL_TRIGGER_SERVICE_ACCOUNT_EMAIL=
AUTO_CREATE_SCHEMA=1
TRAIN_TRACKER_SHEET_ID=
# Use either a local credential file or a Heroku config var containing JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEETS_BATCH_SECONDS=180
GOOGLE_SHEETS_BATCH_ROWS=100
GOOGLE_SHEETS_MAX_PENDING_ROWS=10000
GOOGLE_SHEETS_ROTATION=monthly
GOOGLE_SHEETS_REQUIRED=0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TZ=America/Detroit
